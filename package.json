{
  "name": "adonisjs-maintenance",
  "version": "2.0.3",
  "description": "A maintenance mode for the AdonisJS framework",
  "main": "build/index.js",
  "scripts": {
    "clean": "del-cli build",
    "compile": "npm run clean && tsc",
    "build": "npm run compile",
    "postbuild": "npm run index:commands",
    "release": "np --no-tests",
    "version": "npm run build",
    "index:commands": "adonis-kit index build/commands"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MichaelBelgium/adonisjs-maintenance.git"
  },
  "keywords": [
    "adonisjs",
    "maintenance",
    "maintenance mode",
    "typescript"
  ],
  "author": "michaelbelgium.me,Michael V",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/MichaelBelgium/adonisjs-maintenance/issues"
  },
  "homepage": "https://github.com/MichaelBelgium/adonisjs-maintenance#readme",
  "devDependencies": {
    "@adonisjs/core": "^7.0.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@types/node": "^25.3.0",
    "copyfiles": "^2.4.1",
    "del-cli": "^7.0.0",
    "np": "^11.0.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@adonisjs/core": "^7.0.0"
  },
  "files": [
    "build"
  ],
  "np": {
    "message": "chore(release): %s",
    "contents": ".",
    "anyBranch": false
  },
  "type": "module",
  "exports": {
    ".": "./build/index.js",
    "./commands": "./build/commands/main.js",
    "./maintenance_middleware": "./build/src/maintenance_middleware.js",
    "./maintenance_provider": "./build/providers/maintenance_provider.js"
  }
}
